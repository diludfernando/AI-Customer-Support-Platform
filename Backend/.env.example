# ===================================================================
# AI Customer Support Platform - Backend Environment Variables
# Copy this file to '.env' or set environment variables in your server environment / launchSettings.json
# ===================================================================

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Database Configuration
# Set UseInMemoryDatabase=true for local dev without PostgreSQL, or false to use PostgreSQL
UseInMemoryDatabase=true
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aicustomersupport;Username=postgres;Password=postgres

# JWT Authentication Security
JwtSettings__SecretKey=SUPER_SECRET_KEY_FOR_AI_CUSTOMER_SUPPORT_PLATFORM_123456789_EXTENDED_KEY
JwtSettings__Issuer=AICustomerSupportApi
JwtSettings__Audience=AICustomerSupportClient

# AI & RAG Pipeline Credentials & Model Configuration
# API key for Google Gemini LLM API (if unset, offline fallback RAG engine is used)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# CORS & Network Configuration
AllowedHosts=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

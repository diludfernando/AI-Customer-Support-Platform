# ===================================================================
# AI Customer Support Platform - Frontend Environment Variables (Vite)
# Copy this file to '.env' or '.env.local' in the Frontend directory
# Note: Vite requires environment variables to start with the 'VITE_' prefix.
# ===================================================================

# Backend ASP.NET Core API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Application Metadata & Title
VITE_APP_TITLE=AI Customer Support Platform

# Application Configuration
VITE_ENABLE_MOCK_DATA=true
VITE_DEFAULT_LANGUAGE=en
